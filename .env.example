# ---------------------------------------------------------------------------
# Verba environment variables.
#
# Copy to .env.local for development, and set the same values in your hosting
# provider for production. Never commit a filled-in copy.
# ---------------------------------------------------------------------------

# Required. Supabase project URL, from Project Settings -> Data API.
# Local development with the Supabase CLI: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Required. The browser-safe key, from Project Settings -> API Keys.
# Newer projects call this the publishable key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Older projects issue an anon key instead. Set either one; the app accepts
# whichever is present and prefers the publishable key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Recommended in production. The canonical origin, with no trailing slash.
# Used for absolute links in confirmation emails, OpenGraph tags and sitemaps.
# Vercel sets this automatically only if you add it; do add it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Set to "true" only after enabling the Google provider in
# Supabase Auth. The sign-in button appears only when this is true, so there
# is never a button that leads nowhere.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# ---------------------------------------------------------------------------
# Not required by the application.
#
# There is no service role key here on purpose: the app never uses one, and it
# must never reach the browser. Everything runs as the signed-in user with row
# level security doing the enforcement.
# ---------------------------------------------------------------------------
